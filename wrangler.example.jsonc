{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heforshe-campus",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./dist-standalone", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/admin", "/admin/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "heforshe-campus", "database_id": "REPLACE_WITH_REAL_D1_ID", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "heforshe-campus-media" }],
  "triggers": { "crons": ["15 3 * * *"] },
  "vars": {
    "SITE_ORIGIN": "https://REPLACE_WITH_YOUR_DOMAIN",
    "ACCESS_TEAM_DOMAIN": "REPLACE.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD",
    "EDITOR_EMAILS": "",
    "PUBLISHER_EMAILS": "",
    "TURNSTILE_SITE_KEY": ""
  }
}
